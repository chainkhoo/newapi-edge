# =========================================================================
# Edge node configuration
#
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit real credentials or hostnames.
# =========================================================================

# Public hostname clients will use to reach this edge node.
# Point its DNS A record at THIS server's IP (do NOT proxy through a CDN).
# Example: api-cn.example.com
CHILD_DOMAIN=

# Origin server's real public IP address (the box running New API).
# Traffic is sent here directly, bypassing any CDN that fronts ORIGIN_HOST.
# Example: 203.0.113.10
ORIGIN_IP=

# The public hostname your New API is normally served as.
# Used for the upstream Host header and TLS SNI / certificate validation,
# so the origin's vhost routing and HTTPS cert continue to work.
# Example: api.example.com
ORIGIN_HOST=

# Email address registered with Let's Encrypt for automatic TLS certificates.
# Used for expiry notifications. Use a real address you own.
ACME_EMAIL=

# Human-readable label for this edge node (sent as the X-Origin-Node header).
# Useful when you operate multiple edge nodes and want to identify them in
# origin-side logs or allowlists. Example: hk-1, jp-tokyo, us-la
NODE_NAME=edge-1
